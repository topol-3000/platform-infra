# platform-infra — local dev environment variables
# ---------------------------------------------------------
# Copy this file to `.env` (which is gitignored) and edit as needed.
# These values are DEV-ONLY and intentionally weak. Do not reuse for any
# environment that ever sees real data.

# ----- Postgres -----
# A single Postgres cluster hosts:
#   - the `platform` database (schemas: catalog, subscription, billing, provisioning, telemetry)
#   - a separate `keycloak` database for Keycloak's own storage
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform_dev_password
POSTGRES_DB=platform
POSTGRES_HOST_PORT=5432

# ----- Valkey -----
# Valkey runs without auth in dev. If you ever want a password set it via
# VALKEY_PASSWORD and pass --requirepass in docker-compose.yml.
VALKEY_HOST_PORT=6379

# ----- Keycloak -----
# Bootstrap admin user for the Keycloak master realm. Use this only to log
# into the admin console — create proper users inside the `operators` and
# `customers` realms via realm exports or the admin UI.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin
KEYCLOAK_HOST_PORT=8080

# Keycloak uses the same Postgres instance, separate database.
# These mirror POSTGRES_* above and are only here so they appear together.
KC_DB_URL=jdbc:postgresql://postgres:5432/keycloak
KC_DB_USERNAME=platform
KC_DB_PASSWORD=platform_dev_password
